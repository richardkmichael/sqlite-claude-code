-- Test projects virtual table functionality

-- Load extension
.load ./build/claude_code.dylib

-- Test zero-setup: table already exists
.tables

-- Test basic query: count projects
SELECT COUNT(*) as project_count FROM projects;

-- Test column values (should show our test-projects)
SELECT project_id FROM projects ORDER BY project_id;

-- Test all columns
SELECT project_id, directory, created_at, updated_at FROM projects LIMIT 1;

-- Test manual table creation with custom path
CREATE VIRTUAL TABLE test_projects USING claudecode_projects(
  base_directory='./test-projects'
);

-- Verify manual table works
SELECT project_id FROM test_projects ORDER BY project_id;

-- Test that we get 3 projects from test-projects
SELECT COUNT(*) as count FROM test_projects;

-- Test metadata columns are populated
SELECT
  project_id,
  CASE WHEN created_at > 0 THEN 'OK' ELSE 'MISSING' END as has_created,
  CASE WHEN updated_at > 0 THEN 'OK' ELSE 'MISSING' END as has_updated
FROM test_projects
ORDER BY project_id;

-- Test read-only enforcement
-- Note: These operations should fail with "table may not be modified" errors
-- We expect these commands to produce errors - this is correct behavior
.print "\n=== Testing read-only enforcement (expecting errors) ==="

-- Test WHERE clause filtering
.print "\n=== Testing WHERE clause filtering ==="

-- Filter by specific project_id
SELECT COUNT(*) as filtered_count
FROM test_projects
WHERE project_id = (SELECT project_id FROM test_projects LIMIT 1);

-- Filter by directory pattern
SELECT COUNT(*) as dir_filtered_count
FROM test_projects
WHERE directory LIKE '%test-projects%';

-- Test ORDER BY with different columns
.print "\n=== Testing ORDER BY ==="

-- Order by project_id ascending
SELECT project_id FROM test_projects ORDER BY project_id ASC;

-- Order by project_id descending
SELECT project_id FROM test_projects ORDER BY project_id DESC;

-- Order by directory
SELECT project_id, directory FROM test_projects ORDER BY directory;

-- Order by created_at
SELECT project_id, created_at FROM test_projects ORDER BY created_at;

-- Order by updated_at descending
SELECT project_id, updated_at FROM test_projects ORDER BY updated_at DESC;

-- Test edge cases
.print "\n=== Testing edge cases ==="

-- Note: Creating table with non-existent directory would error
-- This is tested manually to avoid script termination
.print "Creating table with non-existent directory would produce error (manual verification)"

-- Verify directory column contains full paths
SELECT project_id, directory FROM test_projects WHERE directory LIKE '%/%';
