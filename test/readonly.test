-- Test read-only enforcement
-- This file contains tests that are expected to produce errors

.load ./build/claude_code.dylib

.print "=== Testing Projects Table Read-Only Enforcement ==="
.print ""

.print "Test 1: Attempting INSERT (should fail with 'table may not be modified'):"
INSERT INTO projects (project_id, directory, created_at, updated_at)
VALUES ('fake-project', '/fake/path', 1234567890, 1234567890);

.print ""
.print "Test 2: Attempting UPDATE (should fail with 'table may not be modified'):"
UPDATE projects SET directory = '/new/path' WHERE project_id = (SELECT project_id FROM projects LIMIT 1);

.print ""
.print "Test 3: Attempting DELETE (should fail with 'table may not be modified'):"
DELETE FROM projects WHERE project_id = (SELECT project_id FROM projects LIMIT 1);

.print ""
.print "=== Testing Sessions Table Read-Only Enforcement ==="
.print ""

.print "Test 4: Attempting INSERT (should fail with 'table may not be modified'):"
INSERT INTO sessions (session_id, project_id, file_path)
VALUES ('test-session-id', 'test-project', '/fake/path.jsonl');

.print ""
.print "Test 5: Attempting UPDATE (should fail with 'table may not be modified'):"
UPDATE sessions SET file_path = '/new/path.jsonl' WHERE session_id = (SELECT session_id FROM sessions LIMIT 1);

.print ""
.print "Test 6: Attempting DELETE (should fail with 'table may not be modified'):"
DELETE FROM sessions WHERE session_id = (SELECT session_id FROM sessions LIMIT 1);

.print ""
.print "=== Testing Messages Table Read-Only Enforcement ==="
.print ""

.print "Test 7: Attempting INSERT (should fail with 'table may not be modified'):"
INSERT INTO messages (message_id, session_id, type)
VALUES ('test-msg-id', 'test-session', 'user');

.print ""
.print "Test 8: Attempting UPDATE (should fail with 'table may not be modified'):"
UPDATE messages SET type = 'system' WHERE message_id = (SELECT message_id FROM messages LIMIT 1);

.print ""
.print "Test 9: Attempting DELETE (should fail with 'table may not be modified'):"
DELETE FROM messages WHERE message_id = (SELECT message_id FROM messages LIMIT 1);

.print ""
.print "=== Expected Results ==="
.print "All 9 tests above should have failed with: 'table may not be modified'"
.print "This confirms that all three virtual tables are read-only as designed."
