-- Test SQL helper functions

-- Load extension
.load ./build/claude_code.dylib

-- Create test messages table
CREATE VIRTUAL TABLE test_messages USING claudecode_messages(
  base_directory='./test-projects'
);

-- Test metadata table exists
.print "\n=== Testing metadata table ==="
SELECT name, signature FROM _claude_code_functions ORDER BY name;

-- Test get_message_role
.print "\n=== Testing get_message_role ==="
SELECT type, get_message_role(json_data) as role
FROM test_messages
WHERE type IN ('user', 'assistant')
LIMIT 4;

-- Test get_message_model
.print "\n=== Testing get_message_model ==="
SELECT DISTINCT get_message_model(json_data) as model
FROM test_messages
WHERE type = 'assistant' AND get_message_model(json_data) IS NOT NULL
LIMIT 5;

-- Test get_message_content
.print "\n=== Testing get_message_content ==="
SELECT SUBSTR(get_message_content(json_data), 1, 50) as content_preview
FROM test_messages
WHERE type = 'user'
LIMIT 3;

-- Test get_message_text (should skip thinking blocks)
.print "\n=== Testing get_message_text ==="
SELECT
  CASE WHEN get_message_text(json_data) IS NOT NULL THEN 'OK' ELSE 'NULL' END as has_text
FROM test_messages
WHERE type = 'assistant'
LIMIT 3;

-- Test is_thinking_message
.print "\n=== Testing is_thinking_message ==="
SELECT
  COUNT(*) as total,
  SUM(is_thinking_message(json_data)) as with_thinking
FROM test_messages
WHERE type = 'assistant';

-- Test message_token_count
.print "\n=== Testing message_token_count ==="
SELECT
  SUM(message_token_count(json_data)) as total_tokens
FROM test_messages
WHERE type = 'assistant';

-- Test NULL handling
.print "\n=== Testing NULL handling ==="
SELECT get_message_role(NULL) as null_role;
SELECT get_message_content(NULL) as null_content;
SELECT is_thinking_message(NULL) as null_thinking;

-- Test invalid JSON handling
.print "\n=== Testing invalid JSON handling ==="
SELECT get_message_role('not json') as invalid_role;
SELECT get_message_content('{}') as empty_content;
